{
  "name": "vex-sidebar",
  "displayName": "VEX Agent",
  "version": "0.0.1",
  "publisher": "enji",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vex-sidebar-container",
          "title": "VEX",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "vex-sidebar-container": [
        {
          "type": "webview",
          "id": "vex-sidebar-view",
          "name": "VEX Agent"
        }
      ]
    }
  },
  "dependencies": {
    "child-process": "^1.0.2"
  }
}
